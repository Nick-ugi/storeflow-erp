# 배포용 compose(docker/docker-compose.yml) 설정. 이 파일을 docker/.env로 복사해서 값을 채운다. (.env는 Git에 올리지 않음)
# docker compose는 compose 파일과 같은 폴더의 .env를 자동으로 읽는다.

# 외부에 여는 포트 (Nginx)
APP_PORT=80

# DB — 컨테이너 내부 네트워크에서만 사용한다. DB_PASSWORD는 필수
DB_NAME=storeflow
DB_USERNAME=storeflow
DB_PASSWORD=

# JWT 서명 키 (필수, 32자 이상). 예: openssl rand -base64 48
JWT_SECRET=

# 백엔드 컨테이너 메모리 상한 (기본 768m, JVM 힙은 이 값의 75%)
# BACKEND_MEMORY_LIMIT=768m
